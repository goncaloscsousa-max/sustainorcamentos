# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite database + uploads
/data
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/

# backups locais (snapshots manuais do projecto)
/backups

# claude code workspace
/.claude

# exports gerados localmente (PDF/Excel de orçamentos)
SUS-*.pdf
SUS-*.xlsx

# screenshots e ficheiros pessoais soltos na raiz
/*.png
/*.jpg
/*.jpeg
/*.heic

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Materiais reais de obras (fotos do cliente) — nao vai para o repo
OBRA LAVRA/

# PDFs locais com export ad-hoc do orçamento
/Sustain Or*.pdf
