# ---------------------------------------------------------------------
# Plataforma de orçamentos — variáveis de ambiente
# Copia para .env (dev) ou para /srv/<app>/shared/.env (prod).
# NUNCA commits secrets reais.
# ---------------------------------------------------------------------

# Ambiente. Em produção: production. Em dev local: development (default).
NODE_ENV=production

# Porta do servidor Next.js. Caddy faz reverse proxy para esta porta.
PORT=3000

# URL pública (com protocolo). Auth.js usa para construir URLs absolutos
# nos callbacks de OAuth e cookies de sessão.
# Em dev: http://localhost:3000
# Em prod: substituir pelo domínio real (ex.: orcamentos.exemplo.pt).
AUTH_URL=https://__DOMAIN__

# Auth.js — segredo usado para assinar JWTs da sessão.
# Gera um novo (32 bytes random) com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: o segredo de prod tem de ser DIFERENTE do de dev.
AUTH_SECRET=

# ---------------------------------------------------------------------
# Persistência
# ---------------------------------------------------------------------

# Caminho absoluto para a base de dados SQLite. Em produção fica fora da
# árvore da release para sobreviver a deploys.
# Dev: ./data/sustain.db
# Prod: /srv/<app>/shared/data/sustain.db
DATABASE_PATH=./data/sustain.db

# Caminho absoluto para a pasta de uploads. Igual lógica que DATABASE_PATH.
UPLOADS_ROOT=./data/uploads

# Pasta de destino dos backups SQLite (usado por `npm run db:backup`).
BACKUP_DIR=./data/backups

# ---------------------------------------------------------------------
# IA — Anthropic
# ---------------------------------------------------------------------

# API key da Anthropic. Gera-se em https://console.anthropic.com/settings/keys.
# Em prod, a chave deve ser EXCLUSIVA para esta app (não reutilizar a de dev).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# Branding por instância
# Estes valores aparecem em UI (header, login, dashboard) e nos exports
# PDF/Excel. Cada cliente tem o seu .env próprio — o código é genérico.
# ---------------------------------------------------------------------

# Nome curto. Usado no header, login, e título do browser.
BRAND_NAME=Orçamentos

# Tagline opcional debaixo do nome no login (vazio = não aparece).
BRAND_TAGLINE=

# Nome legal completo. Usado no PDF/Excel exportados, na página inicial,
# e injectado nos prompts de IA como "a empresa para que trabalhas".
COMPANY_LEGAL_NAME=Empresa

# Slogan curto que aparece debaixo do nome da empresa no PDF (opcional).
COMPANY_PDF_SLOGAN=

# Identificação fiscal e contactos — todos opcionais. Aparecem só se
# preenchidos.
COMPANY_NIF=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_WEBSITE=
COMPANY_ADDRESS=
COMPANY_POSTAL_CODE=
COMPANY_LOCALITY=

# URL ou caminho público para um logótipo (opcional). Reservado para uso
# futuro (placeholder).
LOGO_URL=

# ---------------------------------------------------------------------
# Seed (apenas para `npm run db:seed` — primeira execução)
# ---------------------------------------------------------------------

# Utilizador admin inicial. Não usado em runtime, só pelo seed.
# Em prod, define ADMIN_PASSWORD uma vez, corre o seed, e remove daqui.
ADMIN_EMAIL=
ADMIN_NOME=Admin
ADMIN_PASSWORD=
