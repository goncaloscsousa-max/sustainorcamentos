# ---------------------------------------------------------------------
# Sustain Orçamentos — variáveis de ambiente
# Copia este ficheiro para .env e preenche os valores.
# ---------------------------------------------------------------------

# Auth.js — segredo usado para assinar JWTs da sessão.
# Gera um novo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Caminho para a base de dados SQLite (relativo ou absoluto).
# Default: ./data/sustain.db
DATABASE_PATH=./data/sustain.db

# Utilizador admin inicial (usado apenas pelo seed script `npm run db:seed`).
ADMIN_EMAIL=info@sustain.pt
ADMIN_NOME=Gonçalo Duarte
ADMIN_PASSWORD=

# NIF da Sustain (placeholder até ser fornecido). Usado na UI e PDFs.
NIF_SUSTAIN=

# API Anthropic — usada a partir da Fase 5 (análise IA).
ANTHROPIC_API_KEY=
