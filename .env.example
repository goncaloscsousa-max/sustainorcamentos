# ---------------------------------------------------------------------
# Sustain Orçamentos — variáveis de ambiente
# Copia para .env (dev) ou para /srv/sustain-orcamentos/shared/.env (prod).
# NUNCA commits secrets reais.
# ---------------------------------------------------------------------

# Ambiente. Em produção: production. Em dev local: development (default).
NODE_ENV=production

# Porta do servidor Next.js. Caddy faz reverse proxy para esta porta.
PORT=3000

# URL pública (com protocolo). Auth.js usa para construir URLs absolutos
# nos callbacks de OAuth e cookies de sessão.
# Em dev: http://localhost:3000
# Em prod: substituir __DOMAIN__ pelo domínio real (ex.: orcamentos.exemplo.pt).
AUTH_URL=https://__DOMAIN__

# Auth.js — segredo usado para assinar JWTs da sessão.
# Gera um novo (32 bytes random) com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: o segredo de prod tem de ser DIFERENTE do de dev.
AUTH_SECRET=

# ---------------------------------------------------------------------
# Persistência
# ---------------------------------------------------------------------

# Caminho absoluto para a base de dados SQLite. Em produção fica fora da
# árvore da release para sobreviver a deploys.
# Dev: ./data/sustain.db
# Prod: /srv/sustain-orcamentos/shared/data/sustain.db
DATABASE_PATH=./data/sustain.db

# Caminho absoluto para a pasta de uploads. Igual lógica que DATABASE_PATH.
# Dev: ./data/uploads
# Prod: /srv/sustain-orcamentos/shared/uploads
UPLOADS_ROOT=./data/uploads

# Pasta de destino dos backups SQLite (usado por `npm run db:backup`).
# Dev: ./data/backups
# Prod: /srv/sustain-orcamentos/shared/backups
BACKUP_DIR=./data/backups

# ---------------------------------------------------------------------
# IA — Anthropic
# ---------------------------------------------------------------------

# API key da Anthropic. Gera-se em https://console.anthropic.com/settings/keys.
# Em prod, a chave deve ser EXCLUSIVA para esta app (não reutilizar a de dev).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# Empresa — exibido em PDFs/Excel exportados
# ---------------------------------------------------------------------

# NIF da Sustain. Aparece no rodapé dos exports. Se vazio, é mostrado o
# placeholder `{{NIF_SUSTAIN}}` (ver lib/export/load-orcamento.ts).
NIF_SUSTAIN=

# ---------------------------------------------------------------------
# Seed (apenas para `npm run db:seed` — primeira execução)
# ---------------------------------------------------------------------

# Utilizador admin inicial. Não usado em runtime, só pelo seed.
# Em prod, define ADMIN_PASSWORD uma vez, corre o seed, e remove daqui.
ADMIN_EMAIL=info@sustain.pt
ADMIN_NOME=Gonçalo Duarte
ADMIN_PASSWORD=
